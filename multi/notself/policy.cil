(handleunknown deny)
(class CLASS1 (PERM1A PERM1B PERM1C PERM1D))
(class CLASS2 (PERM2A PERM2B PERM2C PERM2D))
(class CLASS3 (PERM3A PERM3B PERM3C PERM3D))
(class CLASS4 (ioctl))
(class CLASS5 (ioctl))
(class CLASS6 (ioctl))
(classorder (CLASS1 CLASS2 CLASS3 CLASS4 CLASS5 CLASS6))
(sid kernel)
(sidorder (kernel))
(user USER1)
(role ROLE1)
(type TYPE1)
(type TYPE2)
(type TYPE3)
(typeattribute TATTR1)
(typeattribute TATTR2)
(typeattribute TATTR3)
(typeattributeset TATTR1 (TYPE1 TYPE2 TYPE3))
(typeattributeset TATTR2 (TYPE1 TYPE2))
(typeattributeset TATTR3 (and TATTR1 (not TATTR2)))
(category CAT1)
(categoryorder (CAT1))
(sensitivity SENS1)
(sensitivityorder (SENS1))
(sensitivitycategory SENS1 (CAT1))
(roletype ROLE1 TYPE1)
(userrole USER1 ROLE1)
(userlevel USER1 (SENS1))
(userrange USER1 ((SENS1)(SENS1 (CAT1))))
(sidcontext kernel (USER1 ROLE1 TYPE1 ((SENS1)(SENS1))))


