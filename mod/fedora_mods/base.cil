(booleanif (secure_mode_policyload)
    (false
        (allow can_setbool boolean_type (security (setbool)))
        (allow can_load_policy security_t (security (load_policy)))
        (allow can_setenforce security_t (file (ioctl read write getattr lock append open)))
        (allow can_setenforce security_t (dir (ioctl read getattr lock open search)))
        (allow can_setenforce sysfs_t (dir (getattr open search)))
        (allow can_setenforce sysfs_t (dir (getattr open search)))
        (allow can_setenforce sysfs_t (filesystem (getattr)))
        (allow can_setenforce security_t (security (setenforce)))
    )
)
(booleanif (secure_mode_insmod)
    (false
        (allow can_load_kernmodule kernel_t (process (setsched)))
        (allow can_load_kernmodule self (capability (sys_nice)))
        (allow can_load_kernmodule modules_object_t (system (module_load)))
        (allow can_load_kernmodule modules_object_t (lnk_file (read getattr)))
