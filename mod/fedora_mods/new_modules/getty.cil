    (dontaudit getty_t rhgb_devpts_t (chr_file (ioctl read write getattr lock append open)))
)
(optional getty_optional_9
    (typeattributeset cil_gen_require var_t)
    (typeattributeset cil_gen_require var_run_t)
    (typeattributeset cil_gen_require device_t)
    (typeattributeset cil_gen_require udev_var_run_t)
    (allow getty_t device_t (dir (getattr open search)))
    (allow getty_t device_t (dir (ioctl read getattr lock open search)))
    (allow getty_t device_t (dir (getattr open search)))
    (allow getty_t device_t (lnk_file (read getattr)))
    (allow getty_t var_t (lnk_file (read getattr)))
    (allow getty_t var_run_t (lnk_file (read getattr)))
    (allow getty_t var_t (dir (getattr open search)))
    (allow getty_t var_run_t (dir (getattr open search)))
    (allow getty_t udev_var_run_t (dir (ioctl read getattr lock open search)))
    (allow getty_t udev_var_run_t (dir (getattr open search)))
    (allow getty_t udev_var_run_t (file (ioctl read getattr lock open)))
    (allow getty_t udev_var_run_t (dir (getattr open search)))
    (allow getty_t udev_var_run_t (lnk_file (read getattr)))
)
(filecon "/etc/mgetty(/.*)?" any (system_u object_r getty_etc_t ((s0) (s0))))
(filecon "/usr/lib/systemd/system/[^/]*getty.*" file (system_u object_r getty_unit_file_t ((s0) (s0))))
(filecon "/usr/bin/.*getty" file (system_u object_r getty_exec_t ((s0) (s0))))
(filecon "/var/log/mgetty.*\.log.*" file (system_u object_r getty_log_t ((s0) (s0))))
(filecon "/var/log/vgetty.*\.log.*" file (system_u object_r getty_log_t ((s0) (s0))))
(filecon "/run/mgetty\.pid.*" file (system_u object_r getty_var_run_t ((s0) (s0))))
(filecon "/run/agetty\.reload.*" file (system_u object_r getty_var_run_t ((s0) (s0))))
(filecon "/var/spool/fax(/.*)?" any (system_u object_r getty_var_run_t ((s0) (s0))))
(filecon "/var/spool/voice(/.*)?" any (system_u object_r getty_var_run_t ((s0) (s0))))
