(filecon "/var/log/plymouth.*\.log.*" any (system_u object_r plymouthd_var_log_t ((s0) (s0))))
(filecon "/usr/bin/plymouthd" file (system_u object_r plymouthd_exec_t ((s0) (s0))))
(filecon "/var/spool/plymouth(/.*)?" any (system_u object_r plymouthd_spool_t ((s0) (s0))))
