(type pcmsensor_t)
(roletype object_r pcmsensor_t)
(typepermissive pcmsensor_t)
(type pcmsensor_exec_t)
(roletype object_r pcmsensor_exec_t)
(roleattributeset cil_gen_require system_r)
(typeattributeset cil_gen_require direct_run_init)
(typeattributeset cil_gen_require direct_init)
