(typeattributeset cil_gen_require unreserved_port_t)
(typeattributeset cil_gen_require ephemeral_port_t)
(typeattributeset cil_gen_require defined_port_type)
(typeattributeset cil_gen_require device_t)
(typeattributeset cil_gen_require cpu_device_t)
(typeattributeset cil_gen_require sysfs_t)
(allow pcmsensor_t pcmsensor_exec_t (file (entrypoint)))
(allow pcmsensor_t pcmsensor_exec_t (file (ioctl read getattr lock map execute open)))
(typetransition initrc_domain pcmsensor_exec_t process pcmsensor_t)
(allow pcmsensor_t self (capability (sys_rawio sys_resource)))
(allow pcmsensor_t self (capability2 (perfmon)))
(allow pcmsensor_t self (perf_event (open cpu kernel read)))
(allow pcmsensor_t self (process (ptrace setsched setrlimit)))
(allow pcmsensor_t self (tcp_socket (ioctl read write create getattr setattr lock append bind connect listen accept getopt setopt shutdown)))
(allow pcmsensor_t proc_t (dir (getattr open search)))
(allow pcmsensor_t proc_t (file (ioctl read getattr lock open)))
(allow pcmsensor_t debugfs_t (dir (getattr open search)))
(allow pcmsensor_t debugfs_t (file (ioctl read getattr lock open)))
(allow pcmsensor_t debugfs_t (dir (getattr open search)))
