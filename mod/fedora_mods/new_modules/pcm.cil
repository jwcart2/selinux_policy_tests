(allow pcmsensor_t proc_t (dir (getattr open search)))
(allow pcmsensor_t proc_t (file (ioctl write getattr lock append open)))
(allow pcmsensor_t node_t (tcp_socket (node_bind)))
(allow pcmsensor_t port_t (tcp_socket (name_bind)))
(allow pcmsensor_t unreserved_port_t (tcp_socket (name_bind)))
(allow pcmsensor_t ephemeral_port_t (tcp_socket (name_bind)))
(dontaudit pcmsensor_t defined_port_type (tcp_socket (name_bind)))
(allow pcmsensor_t device_t (dir (getattr open search)))
(allow pcmsensor_t cpu_device_t (chr_file (ioctl read write getattr lock append open)))
(allow pcmsensor_t sysfs_t (dir (getattr open search)))
(allow pcmsensor_t sysfs_t (file (ioctl read write getattr lock append open)))
(allow pcmsensor_t sysfs_t (dir (getattr open search)))
(allow pcmsensor_t sysfs_t (lnk_file (read getattr)))
(allow pcmsensor_t sysfs_t (dir (getattr open search)))
(allow pcmsensor_t sysfs_t (dir (ioctl read getattr lock open search)))
(optional pcm_optional_2
    (typeattributeset cil_gen_require systemd_socket_proxyd_t)
    (allow pcmsensor_t systemd_socket_proxyd_t (unix_stream_socket (connectto)))
)
(filecon "/usr/bin/pcm-sensor-server" file (system_u object_r pcmsensor_exec_t ((s0) (s0))))
