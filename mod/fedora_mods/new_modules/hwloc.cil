(allow hwloc_dhwd_t sysfs_t (dir (getattr open search)))
(allow hwloc_dhwd_t sysfs_t (lnk_file (read getattr)))
(allow hwloc_dhwd_t sysfs_t (dir (getattr open search)))
(allow hwloc_dhwd_t sysfs_t (dir (ioctl read getattr lock open search)))
(filecon "/usr/bin/hwloc-dump-hwdata" file (system_u object_r hwloc_dhwd_exec_t ((s0) (s0))))
(filecon "/usr/lib/systemd/system/hwloc-dump-hwdata.*" file (system_u object_r hwloc_dhwd_unit_t ((s0) (s0))))
(filecon "/run/hwloc(/.*)?" any (system_u object_r hwloc_var_run_t ((s0) (s0))))
