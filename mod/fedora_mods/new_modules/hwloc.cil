(allow hwloc_dhwd_t hwloc_dhwd_exec_t (file (entrypoint)))
(allow hwloc_dhwd_t hwloc_dhwd_exec_t (file (ioctl read getattr lock map execute open)))
(typetransition initrc_domain hwloc_dhwd_exec_t process hwloc_dhwd_t)
(allow hwloc_dhwd_t hwloc_var_run_t (dir (ioctl read write create getattr setattr lock unlink link rename open watch watch_reads add_name remove_name reparent search rmdir)))
(allow hwloc_dhwd_t hwloc_var_run_t (file (ioctl read write create getattr setattr lock append unlink link rename open watch watch_reads)))
(allow hwloc_dhwd_t var_t (dir (getattr open search)))
(allow hwloc_dhwd_t var_run_t (dir (ioctl read write getattr lock open add_name remove_name search)))
