            (allow irc_t node_t (udp_socket (node_bind)))
            (allow irc_t node_t (tcp_socket (node_bind)))
            (allow irc_t port_type (udp_socket (recv_msg)))
            (allow irc_t port_type (udp_socket (send_msg)))
            (allow irc_t port_type (tcp_socket (recv_msg send_msg)))
            (allow irc_t node_t (node (udp_recv recvfrom)))
            (allow irc_t node_t (node (udp_send sendto)))
            (allow irc_t node_t (node (tcp_recv tcp_send recvfrom sendto)))
            (allow irc_t netif_t (netif (udp_recv ingress)))
            (allow irc_t netif_t (netif (udp_send egress)))
            (allow irc_t netif_t (netif (tcp_recv tcp_send ingress egress)))
            (allow irc_t var_yp_t (file (ioctl read getattr lock open)))
            (allow irc_t var_yp_t (lnk_file (read getattr)))
            (allow irc_t var_yp_t (dir (ioctl read getattr lock open search)))
            (allow irc_t self (udp_socket (ioctl read write create getattr setattr lock append bind connect getopt setopt shutdown)))
            (allow irc_t self (tcp_socket (ioctl read write create getattr setattr lock append bind connect listen accept getopt setopt shutdown)))
            (dontaudit irc_t self (capability (net_bind_service)))
        )
    )
)
(optional irc_optional_3
    (typeattributeset cil_gen_require newrole_t)
    (allow irc_t newrole_t (fd (use)))
)
(filecon "HOME_DIR/\.ircmotd" file (system_u object_r irc_home_t ((s0) (s0))))
(filecon "HOME_DIR/\.irssi(/.*)?" any (system_u object_r irc_home_t ((s0) (s0))))
(filecon "HOME_DIR/irclog(/.*)?" any (system_u object_r irc_home_t ((s0) (s0))))
(filecon "/etc/irssi\.conf" file (system_u object_r irc_conf_t ((s0) (s0))))
(filecon "/usr/bin/[st]irc" file (system_u object_r irc_exec_t ((s0) (s0))))
(filecon "/usr/bin/ircII" file (system_u object_r irc_exec_t ((s0) (s0))))
(filecon "/usr/bin/irssi" file (system_u object_r irc_exec_t ((s0) (s0))))
(filecon "/usr/bin/tinyirc" file (system_u object_r irc_exec_t ((s0) (s0))))
