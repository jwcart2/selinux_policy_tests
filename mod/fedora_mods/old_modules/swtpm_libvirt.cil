(roleattributeset cil_gen_require system_r)
(typeattributeset cil_gen_require admin_home_t)
(typeattributeset cil_gen_require device_t)
(typeattributeset cil_gen_require fs_t)
(typeattributeset cil_gen_require hugetlbfs_t)
(typeattributeset cil_gen_require qemu_var_run_t)
(typeattributeset cil_gen_require svirt_t)
(typeattributeset cil_gen_require svirt_image_t)
(typeattributeset cil_gen_require svirt_tcg_t)
(typeattributeset cil_gen_require svirt_tcg_devpts_t)
(typeattributeset cil_gen_require swtpm_t)
(typeattributeset cil_gen_require urandom_device_t)
(typeattributeset cil_gen_require var_lib_t)
(typeattributeset cil_gen_require var_log_t)
(typeattributeset cil_gen_require virt_log_t)
(typeattributeset cil_gen_require virt_var_lib_t)
(typeattributeset cil_gen_require virtqemud_t)
(allow virtqemud_t admin_home_t (file (write setattr relabelfrom relabelto)))
(allow virtqemud_t device_t (filesystem (unmount)))
(allow virtqemud_t fs_t (filesystem (getattr)))
(allow virtqemud_t hugetlbfs_t (dir (relabelfrom)))
(allow virtqemud_t qemu_var_run_t (file (relabelfrom relabelto)))
(allow virtqemud_t qemu_var_run_t (sock_file (relabelfrom)))
(allow virtqemud_t self (capability (sys_module sys_nice)))
(allow virtqemud_t self (fifo_file (relabelfrom)))
(allow virtqemud_t svirt_t (process (noatsecure siginh rlimitinh)))
(allow virtqemud_t svirt_image_t (chr_file (setattr)))
(allow virtqemud_t svirt_tcg_t (dir (search)))
(allow virtqemud_t svirt_tcg_t (file (read open)))
(allow virtqemud_t svirt_tcg_t (process (transition signull signal setsched noatsecure siginh rlimitinh)))
(allow virtqemud_t svirt_tcg_t (unix_stream_socket (create bind listen connectto)))
(allow virtqemud_t svirt_tcg_devpts_t (chr_file (ioctl read write open)))
(allow virtqemud_t swtpm_t (process (signull noatsecure siginh rlimitinh)))
(allow virtqemud_t urandom_device_t (chr_file (setattr)))
(allow virtqemud_t var_lib_t (dir (add_name)))
(allow virtqemud_t var_lib_t (file (write create setattr)))
(allow virtqemud_t var_log_t (dir (add_name remove_name)))
(allow virtqemud_t var_log_t (file (write create setattr relabelfrom relabelto unlink)))
(allow virtqemud_t virt_log_t (dir (remove_name)))
(allow virtqemud_t virt_log_t (file (unlink)))
(allow virtqemud_t virt_var_lib_t (dir (relabelfrom relabelto)))
(allow virtqemud_t virt_var_lib_t (file (relabelfrom relabelto)))
