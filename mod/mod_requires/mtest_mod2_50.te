module mtest_mod2_50 1.0;

# Module must have a requires section for the module
# Removing the require block below will result in an error
require {
  type TYPE1;
}

TYPE TM2;

optional {
  require {
    class CLASS1 { PERM1 };
  }
  allow TM2 self : CLASS1 PERM1;
}

optional {
  require {
    type TM2;
  }
  role RM2;
  role RM2 types TM2;
}
