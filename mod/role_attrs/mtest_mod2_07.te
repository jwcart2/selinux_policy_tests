role ar8c types t8c;

role_transition ar1c t1c : cl3 rn1c;
role_transition ar2c t2c : cl3 rn2c;
role_transition ar3 t3_ : cl3 rn3;
role_transition ar3c t3c : cl3 rn3c;
role_transition ar4c t4c : cl3 rn4c;
role_transition ar5c t5c : cl3 rn5c;
