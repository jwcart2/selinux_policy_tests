module mtest_mod2_07 1.0;

require {
	class cl3 { p3 };
	attribute_role ar1;
	attribute_role ar1a;
	attribute_role ar2;
	attribute_role ar2b;
	sensitivity SENS1;
}

type t1c;
type t2c;
type t3_;
type t3c;
type t4c;
type t5c;
type t6c;
type t7c;
type t8c;
type td3;

allow td3 t3c : cl3 p3;

attribute_role ar1c;
