)
(booleanif b_b3
    (true
        (allow b_a2 b_td (CLASS (PERM)))
        (allow b_t1 b_td (CLASS (PERM)))
        (allow b_td b_a2 (CLASS (PERM)))
        (allow b_td b_t1 (CLASS (PERM)))
