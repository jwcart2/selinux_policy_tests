;; Test allowing "." in global names

(class CLASS (PERM))
(classorder (CLASS))
(sid SID)
(sidorder (SID))
(user USER)
(role ROLE)
(type TYPE)
(category CAT)
(categoryorder (CAT))
(sensitivity SENS)
(sensitivityorder (SENS))
(sensitivitycategory SENS (CAT))
(allow TYPE self (CLASS (PERM)))
(roletype ROLE TYPE)
(userrole USER ROLE)
(userlevel USER (SENS))
(userrange USER ((SENS)(SENS (CAT))))
(sidcontext SID (USER ROLE TYPE ((SENS)(SENS))))

;; Allowed
(type t1.a)
;(type .t1b)
(allow t1.a self (CLASS (PERM)))
;(allow .t1b self (CLASS (PERM)))

;; Allowed
(tunable tun2 true)
(tunableif (tun2)
  (true
    (type t2.a)
    ;(type .t2b)
    (allow t2.a self (CLASS (PERM)))
	;(allow .t2b self (CLASS (PERM)))
  )
)

