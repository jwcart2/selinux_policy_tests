(booleanif (gitosis_can_sendmail)
    (true
        (dontaudit mta_user_agent gitosis_t (unix_stream_socket (ioctl read write getattr setattr lock append bind connect getopt setopt shutdown)))
        (allow mta_user_agent gitosis_t (fifo_file (ioctl read write getattr lock append)))
        (allow mta_user_agent gitosis_t (process (sigchld)))
        (allow mta_user_agent gitosis_t (fd (use)))
        (allow system_mail_t gitosis_t (process (sigchld)))
        (allow system_mail_t gitosis_t (fifo_file (ioctl read write getattr lock append)))
        (allow system_mail_t gitosis_t (fd (use)))
        (typetransition gitosis_t mta_exec_type process system_mail_t)
        (allow gitosis_t system_mail_t (process (transition)))
        (allow gitosis_t mta_exec_type (file (ioctl read getattr map execute open)))
        (allow gitosis_t bin_t (lnk_file (read getattr)))
        (allow gitosis_t bin_t (dir (getattr open search)))
        (allow gitosis_t mta_exec_type (lnk_file (read getattr)))
    )
)
(filecon "/srv/lib/gitosis(/.*)?" any (system_u object_r gitosis_var_lib_t ((s0) (s0))))
(filecon "/usr/bin/gitosis-serve" file (system_u object_r gitosis_exec_t ((s0) (s0))))
(filecon "/usr/bin/gl-auth-command" file (system_u object_r gitosis_exec_t ((s0) (s0))))
(filecon "/var/lib/gitosis(/.*)?" any (system_u object_r gitosis_var_lib_t ((s0) (s0))))
(filecon "/var/lib/gitolite(3)?(/.*)?" any (system_u object_r gitosis_var_lib_t ((s0) (s0))))
