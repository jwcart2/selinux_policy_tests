(allow gitosis_t gitosis_exec_t (file (entrypoint)))
(allow gitosis_t gitosis_exec_t (file (ioctl read getattr lock map execute open)))
(allow gitosis_t self (fifo_file (ioctl read write getattr lock append open)))
(allow gitosis_t gitosis_var_lib_t (dir (getattr open search)))
(allow gitosis_t gitosis_var_lib_t (file (ioctl read getattr map execute open execute_no_trans)))
(allow gitosis_t gitosis_var_lib_t (dir (ioctl read write getattr lock open add_name remove_name search)))
(allow gitosis_t gitosis_var_lib_t (file (ioctl read write create getattr setattr lock append unlink link rename open watch watch_reads)))
(allow gitosis_t gitosis_var_lib_t (dir (ioctl read write getattr lock open add_name remove_name search)))
(allow gitosis_t gitosis_var_lib_t (lnk_file (ioctl read write create getattr setattr lock append unlink link rename watch watch_reads)))
(allow gitosis_t gitosis_var_lib_t (dir (ioctl read write getattr lock open add_name remove_name search)))
(allow gitosis_t gitosis_var_lib_t (dir (ioctl read write create getattr setattr lock unlink link rename open watch watch_reads add_name remove_name reparent search rmdir)))
(allow gitosis_t netif_t (netif (tcp_recv tcp_send ingress egress)))
(allow gitosis_t node_t (node (tcp_recv tcp_send recvfrom sendto)))
