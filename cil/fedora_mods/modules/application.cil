(typeattribute application_domain_type)
(typeattribute application_exec_type)
(roleattributeset cil_gen_require system_r)
(typeattributeset cil_gen_require privfd)
(typeattributeset cil_gen_require user_home_t)
(typeattributeset cil_gen_require admin_home_t)
(typeattributeset cil_gen_require user_tmp_t)
(typeattributeset cil_gen_require userdomain)
(typeattributeset cil_gen_require logfile)
(typeattributeset cil_gen_require non_security_file_type)
(typeattributeset cil_gen_require login_pgm)
(allow application_domain_type privfd (fd (use)))
(allow application_domain_type user_home_t (file (getattr append)))
(allow application_domain_type admin_home_t (file (getattr append)))
(allow application_domain_type user_tmp_t (file (getattr append)))
(allow application_domain_type user_tmp_t (file (ioctl read write getattr lock append)))
(allow application_domain_type user_tmp_t (file (ioctl read write getattr lock append map)))
(allow application_domain_type userdomain (fifo_file (ioctl read write getattr lock append)))
(allow application_domain_type logfile (file (ioctl getattr lock append)))
(dontaudit application_domain_type non_security_file_type (dir (getattr open search)))
(allow application_domain_type login_pgm (process (sigchld)))
(optional application_optional_2
    (typeattributeset cil_gen_require afs_t)
    (allow application_domain_type afs_t (udp_socket (read write)))
)
(optional application_optional_3
    (typeattributeset cil_gen_require cfengine_var_log_t)
    (typeattributeset cil_gen_require cfengine_var_lib_t)
    (allow application_domain_type cfengine_var_lib_t (dir (getattr open search)))
    (allow application_domain_type cfengine_var_log_t (file (ioctl getattr lock append)))
)
(optional application_optional_4
    (typeattributeset cil_gen_require user_cron_spool_t)
    (typeattributeset cil_gen_require crond_t)
    (allow application_domain_type user_cron_spool_t (file (ioctl read write getattr lock append)))
    (allow application_domain_type crond_t (process (sigchld)))
)
(optional application_optional_5
    (typeattributeset cil_gen_require sshd_t)
    (allow application_domain_type sshd_t (unix_stream_socket (ioctl read write getattr setattr lock append bind connect listen accept getopt setopt shutdown)))
)
(optional application_optional_6
    (typeattributeset cil_gen_require screen_domain)
    (allow application_domain_type screen_domain (process (sigchld)))
)
(optional application_optional_7
    (typeattributeset cil_gen_require sudodomain)
    (allow application_domain_type sudodomain (process (sigchld)))
)
