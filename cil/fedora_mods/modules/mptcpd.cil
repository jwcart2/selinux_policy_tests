)
(filecon "/etc/mptcpd(/.*)?" any (system_u object_r mptcpd_etc_t ((s0) (s0))))
(filecon "/usr/libexec/mptcpd" file (system_u object_r mptcpd_exec_t ((s0) (s0))))
