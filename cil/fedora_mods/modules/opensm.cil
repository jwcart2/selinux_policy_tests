(filecon "/usr/libexec/opensm-launch" file (system_u object_r opensm_exec_t ((s0) (s0))))
(filecon "/var/cache/opensm(/.*)?" any (system_u object_r opensm_cache_t ((s0) (s0))))
(filecon "/var/log/opensm.*" file (system_u object_r opensm_log_t ((s0) (s0))))
