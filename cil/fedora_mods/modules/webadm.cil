        )
    )
    (optional webadm_optional_8
        (typeattributeset cil_gen_require policykit_t)
        (allow policykit_t webadm_t (dir (ioctl read getattr lock open search)))
        (allow policykit_t webadm_t (file (ioctl read getattr lock open)))
        (allow policykit_t webadm_t (lnk_file (read getattr)))
        (allow policykit_t webadm_t (process (getattr)))
        (allow webadm_t policykit_t (dbus (send_msg)))
        (allow policykit_t webadm_t (dbus (send_msg)))
    )
)
