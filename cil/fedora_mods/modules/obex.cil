        (allow obex_t var_run_t (dir (getattr open search)))
        (allow obex_t bluetooth_t (socket (ioctl read write getattr setattr lock append bind connect getopt setopt shutdown)))
        (allow obex_t bluetooth_var_run_t (dir (getattr open search)))
