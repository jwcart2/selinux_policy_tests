    (allow obex_t var_run_t (dir (getattr open search)))
    (allow obex_t system_dbusd_var_run_t (dir (getattr open search)))
    (allow obex_t system_dbusd_var_run_t (sock_file (write getattr append open)))
    (allow obex_t system_dbusd_t (unix_stream_socket (connectto)))
    (allow obex_t dbusd_etc_t (dir (ioctl read getattr lock open search)))
