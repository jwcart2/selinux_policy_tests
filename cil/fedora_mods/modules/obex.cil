        (allow obex_t bluetooth_tmp_t (sock_file (write getattr append open)))
        (allow obex_t bluetooth_t (unix_stream_socket (connectto)))
        (allow obex_t bluetooth_t (dbus (send_msg)))
        (allow bluetooth_t obex_t (dbus (send_msg)))
