    (allow uml_switch_t systemd_socket_proxyd_t (unix_stream_socket (connectto)))
)
(optional uml_optional_3
    (typeattributeset cil_gen_require virt_driver_domain)
    (typeattributeset cil_gen_require virtd_t)
    (allow uml_t virtd_t (tun_socket (relabelfrom)))
    (allow uml_t virt_driver_domain (tun_socket (relabelfrom)))
    (allow uml_t self (tun_socket (relabelto)))
)
(optional uml_optional_4
    (typeattributeset cil_gen_require newrole_t)
    (allow uml_switch_t newrole_t (process (sigchld)))
    (optional uml_optional_5
        (typeattributeset cil_gen_require device_t)
        (typeattributeset cil_gen_require var_t)
        (typeattributeset cil_gen_require var_run_t)
        (typeattributeset cil_gen_require udev_var_run_t)
        (allow uml_switch_t device_t (dir (getattr open search)))
        (allow uml_switch_t device_t (dir (ioctl read getattr lock open search)))
        (allow uml_switch_t device_t (dir (getattr open search)))
        (allow uml_switch_t device_t (lnk_file (read getattr)))
        (allow uml_switch_t var_t (lnk_file (read getattr)))
        (allow uml_switch_t var_run_t (lnk_file (read getattr)))
        (allow uml_switch_t var_t (dir (getattr open search)))
        (allow uml_switch_t var_run_t (dir (getattr open search)))
        (allow uml_switch_t udev_var_run_t (dir (ioctl read getattr lock open search)))
        (allow uml_switch_t udev_var_run_t (dir (getattr open search)))
        (allow uml_switch_t udev_var_run_t (file (ioctl read getattr lock open)))
        (allow uml_switch_t udev_var_run_t (dir (getattr open search)))
        (allow uml_switch_t udev_var_run_t (lnk_file (read getattr)))
    )
)
(filecon "HOME_DIR/\.uml(/.*)?" any (system_u object_r uml_rw_t ((s0) (s0))))
(filecon "/usr/bin/uml_switch" file (system_u object_r uml_switch_exec_t ((s0) (s0))))
(filecon "/run/uml-utilities(/.*)?" any (system_u object_r uml_switch_var_run_t ((s0) (s0))))
