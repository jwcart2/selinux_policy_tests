(booleanif (selinuxuser_udp_server)
    (true
        (allow sysadm_t unreserved_port_type (udp_socket (name_bind)))
    )
)
(booleanif (selinuxuser_tcp_server)
    (true
        (allow sysadm_t unreserved_port_type (tcp_socket (name_bind)))
    )
)
(booleanif (selinuxuser_rw_noexattrfile)
    (true
        (allow sysadm_t noxattrfs (dir (ioctl read write create getattr setattr lock unlink link rename open watch watch_reads add_name remove_name reparent search rmdir)))
        (allow sysadm_t noxattrfs (file (ioctl read write create getattr setattr lock append unlink link rename open watch watch_reads)))
        (allow sysadm_t noxattrfs (dir (ioctl read write getattr lock open add_name remove_name search)))
    )
    (false
        (allow sysadm_t noxattrfs (file (ioctl read getattr lock open)))
        (allow sysadm_t noxattrfs (dir (getattr open search)))
    )
)
(booleanif (deny_bluetooth)
    (false
        (allow sysadm_t self (bluetooth_socket (ioctl read write create getattr setattr lock append bind connect listen accept getopt setopt shutdown)))
    )
)
(booleanif (selinuxuser_use_ssh_chroot)
    (true
        (allow sysadm_t self (capability (setgid setuid sys_chroot)))
    )
)
(booleanif (and (sysadm_exec_content) (use_samba_home_dirs))
    (true
        (allow sysadm_usertype cifs_t (file (ioctl read getattr map execute open execute_no_trans)))
        (allow sysadm_usertype cifs_t (dir (getattr open search)))
        (allow sysadm_usertype cifs_t (dir (ioctl read getattr lock open search)))
    )
)
(booleanif (and (sysadm_exec_content) (use_nfs_home_dirs))
    (true
        (allow sysadm_usertype nfs_t (file (ioctl read getattr map execute open execute_no_trans)))
        (allow sysadm_usertype nfs_t (dir (getattr open search)))
        (allow sysadm_usertype nfs_t (dir (ioctl read getattr lock open search)))
    )
)
(booleanif (sysadm_exec_content)
    (true
        (allow sysadm_usertype user_home_type (file (ioctl read getattr map execute open execute_no_trans)))
        (allow sysadm_usertype user_home_dir_t (dir (getattr open search)))
        (allow sysadm_usertype user_home_type (dir (getattr open search)))
        (allow sysadm_usertype home_root_t (lnk_file (read getattr)))
        (allow sysadm_usertype home_root_t (dir (getattr open search)))
        (allow sysadm_usertype tmp_t (dir (getattr open search)))
        (allow sysadm_usertype tmp_t (lnk_file (read getattr)))
        (allow sysadm_usertype tmp_t (dir (getattr open search)))
        (allow sysadm_usertype tmpfs_t (dir (getattr open search)))
        (allow sysadm_usertype user_tmp_t (file (ioctl read getattr map execute open execute_no_trans)))
        (allow sysadm_usertype user_tmp_t (dir (getattr open search)))
        (allow sysadm_usertype user_tmp_t (file (entrypoint)))
    )
)
(booleanif (use_samba_home_dirs)
    (true
        (allow sysadm_t cifs_t (fifo_file (ioctl read write create getattr setattr lock append unlink link rename open)))
        (allow sysadm_t cifs_t (dir (ioctl read write getattr lock open add_name remove_name search)))
        (allow sysadm_t autofs_t (dir (getattr open search)))
        (allow sysadm_t cifs_t (sock_file (ioctl read write create getattr setattr lock append unlink link rename open)))
        (allow sysadm_t cifs_t (dir (ioctl read write getattr lock open add_name remove_name search)))
        (allow sysadm_t autofs_t (dir (getattr open search)))
        (allow sysadm_t cifs_t (lnk_file (ioctl read write create getattr setattr lock append unlink link rename watch watch_reads)))
        (allow sysadm_t cifs_t (dir (ioctl read write getattr lock open add_name remove_name search)))
        (allow sysadm_t autofs_t (dir (getattr open search)))
        (allow sysadm_t cifs_t (file (ioctl read write create getattr setattr lock append unlink link rename open watch watch_reads)))
        (allow sysadm_t cifs_t (dir (ioctl read write getattr lock open add_name remove_name search)))
        (allow sysadm_t autofs_t (dir (getattr open search)))
        (allow sysadm_t cifs_t (dir (ioctl read write create getattr setattr lock unlink link rename open watch watch_reads add_name remove_name reparent search rmdir)))
        (allow sysadm_t autofs_t (dir (getattr open search)))
        (allow sysadm_t cifs_t (dir (mounton)))
        (allow sysadm_t cifs_t (filesystem (mount)))
    )
)
(booleanif (use_nfs_home_dirs)
    (true
        (allow sysadm_t nfs_t (fifo_file (ioctl read write create getattr setattr lock append unlink link rename open)))
        (allow sysadm_t nfs_t (dir (ioctl read write getattr lock open add_name remove_name search)))
